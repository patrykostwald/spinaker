FROM node:20-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend-spin/package.json frontend-spin/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN corepack enable && pnpm install --frozen-lockfile
COPY packages/ui packages/ui
COPY frontend-spin frontend-spin
ARG NEXT_PUBLIC_DOMAIN=spin.clinic
ARG API_INTERNAL_URL=http://backend:8000
# Przełączniki funkcji muszą być znane już przy budowaniu (wchodzą do kodu przeglądarki); inaczej serwer i przeglądarka
# rysują inną stronę (błąd hydratacji React 418/423, np. przycisk „Zaloguj” tylko po stronie serwera).
ARG NEXT_PUBLIC_ACCOUNTS_ENABLED=false
ARG NEXT_PUBLIC_THREADS_ENABLED=false
ARG NEXT_PUBLIC_PUSH_ENABLED=false
ARG NEXT_PUBLIC_APP_ENABLED=false
ENV NEXT_PUBLIC_DOMAIN=$NEXT_PUBLIC_DOMAIN API_INTERNAL_URL=$API_INTERNAL_URL NEXT_PUBLIC_API_URL=     NEXT_PUBLIC_ACCOUNTS_ENABLED=$NEXT_PUBLIC_ACCOUNTS_ENABLED NEXT_PUBLIC_THREADS_ENABLED=$NEXT_PUBLIC_THREADS_ENABLED     NEXT_PUBLIC_PUSH_ENABLED=$NEXT_PUBLIC_PUSH_ENABLED NEXT_PUBLIC_APP_ENABLED=$NEXT_PUBLIC_APP_ENABLED
RUN pnpm --filter frontend-spin build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
RUN corepack enable
COPY --from=build /app /app
EXPOSE 3000
CMD ["pnpm", "--filter", "frontend-spin", "start"]
