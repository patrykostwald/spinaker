{$SPIN_DOMAIN:spin.clinic} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
		-Server
		-X-Powered-By
	}
	# Ilustracje i fonty zmieniają się rzadko — przeglądarka trzyma je tydzień.
	@static path /illustrations/* /fonts/* /icons/*
	header @static Cache-Control "public, max-age=604800"
	@api path /api/*
	reverse_proxy @api backend:8000
	reverse_proxy frontend:3000
}

# www i dawny adres bety — stałe przekierowanie na domenę główną (DNS obu wskazuje na ten serwer).
www.{$SPIN_DOMAIN:spin.clinic} {
	redir https://{$SPIN_DOMAIN:spin.clinic}{uri} permanent
}

beta.{$SPIN_DOMAIN:spin.clinic} {
	redir https://{$SPIN_DOMAIN:spin.clinic}{uri} permanent
}

# przeszłość.today (właściciel 5.10): ta sama aplikacja; middleware pokazuje drzewo tematów, inne adresy przekierowuje na spin.clinic
przeszlosc.today {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
		-Server
		-X-Powered-By
	}
	@api path /api/*
	reverse_proxy @api backend:8000
	reverse_proxy frontend:3000
}

www.przeszlosc.today {
	redir https://przeszlosc.today{uri} permanent
}

# spina3.pl (14.10.2026): ukryty podgląd frontu z danymi przykładowymi (bez backendu, bez indeksowania).
# Katalog /srv/spina3/dist jest montowany tylko do odczytu (docker-compose.production.yml). Start serwisu = osobny blok api.spina3.pl, patrz docs/SPINA3_WDROZENIE.md.
spina3.pl {
	encode zstd gzip
	root * /srv/spina3/dist
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
		-X-Powered-By
	}
	@podglad path /podglad-44718e42/*
	header @podglad Cache-Control "no-cache"
	try_files {path} {path}/index.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

# www i drugi adres (spinki.org) przekierowują na spina3.pl (DNS wszystkich wskazuje na ten serwer).
www.spina3.pl, spinki.org, www.spinki.org {
	redir https://spina3.pl{uri} permanent
}
