# Copy to ../.env.production on the VPS.  Keep this file private and never commit real values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
# Beta uses beta.spin.clinic. Change this only when promoting the public domain.
SPIN_DOMAIN=beta.spin.clinic
ALLOWED_HOSTS=beta.spin.clinic,backend
CSRF_TRUSTED_ORIGINS=https://beta.spin.clinic
NEXT_PUBLIC_DOMAIN=beta.spin.clinic

# Keep source-mail credentials only if inbound response monitoring is enabled.
SOURCE_MAIL_IMAP_ENABLED=false
SOURCE_MAIL_IMAP_HOST=
SOURCE_MAIL_IMAP_PORT=993
SOURCE_MAIL_IMAP_USERNAME=zrodla@spin.clinic
SOURCE_MAIL_IMAP_PASSWORD=

# Optional public support links. Use only official project profile URLs.
BUYCOFFEE_URL=
PATRONITE_URL=

# Paid X intake stays off until a reviewed monthly budget and token are set.
X_POLITICAL_POLLING_ENABLED=false
X_POLITICAL_BEARER_TOKEN=
X_POLITICAL_PAGE_SIZE=10
X_POLITICAL_DAILY_POST_LIMIT=100
X_POLITICAL_DAILY_REQUEST_LIMIT=100
X_POLITICAL_MONTHLY_USD_LIMIT=5
X_POLITICAL_INITIAL_LOOKBACK_HOURS=24

# User-controlled X sharing: OAuth proves identity, but the portal never posts.
X_USER_OAUTH_ENABLED=false
X_USER_OAUTH_CLIENT_ID=
X_USER_OAUTH_REDIRECT_URI=
X_USER_OAUTH_SUCCESS_PATH=/konto

# Editorial AI reads only approved local citation packets and cannot publish.
NIM_ENABLED=false
NIM_API_KEY=
NIM_EMBEDDING_MODEL=
NIM_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
NIM_RERANK_MODEL=
NIM_RERANK_URL=
GROQ_EDITORIAL_ENABLED=false
GROQ_API_KEY=
GROQ_EDITORIAL_MODEL=
GROQ_EDITORIAL_URL=https://api.groq.com/openai/v1/chat/completions
