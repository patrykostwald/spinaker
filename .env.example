DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
DATABASE_URL=postgres://spin:spin@localhost:5432/spin_clinic
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUSTED_PROXY_COUNT=0
NEWSAPI_ENABLED=false
NEWSAPI_KEY=
NEWSAPI_TIER=free
NEWSAPI_DAILY_REQUEST_LIMIT=100
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
UOKIK_SUDOP_PILOT_ENABLED=false
TWITTER_API_TIER=pay_per_use
TWITTER_MONTHLY_READ_LIMIT=9600
PATRONITE_URL=
SENTRY_DSN=

BUYCOFFEE_URL=
SEJM_TERM=10

# Official, read-only X intake for confirmed political accounts. Keep the token
# only in .env / the deployment secret store; it must never be exposed to Next.js.
X_POLITICAL_POLLING_ENABLED=false
X_POLITICAL_BEARER_TOKEN=
X_POLITICAL_PAGE_SIZE=10
X_POLITICAL_DAILY_POST_LIMIT=100
X_POLITICAL_DAILY_REQUEST_LIMIT=100
X_POLITICAL_MONTHLY_USD_LIMIT=5
X_POLITICAL_INITIAL_LOOKBACK_HOURS=24

# Optional account linking for user-controlled sharing through X OAuth 2.0.
# This uses only `users.read`; no user token is stored and the portal never posts.
X_USER_OAUTH_ENABLED=false
X_USER_OAUTH_CLIENT_ID=
X_USER_OAUTH_REDIRECT_URI=
X_USER_OAUTH_SUCCESS_PATH=/konto

# Public YouTube metadata search. This stores video metadata only, never film
# content or transcripts. Restrict the key by server IP in Google Cloud.
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_DAILY_REQUEST_LIMIT=50

# Hybrid search pilot. Configure server-side only; never NEXT_PUBLIC credentials.
EXTERNAL_SEARCH_ENABLED=false
BRAVE_SEARCH_API_KEY=
EXTERNAL_SEARCH_DAILY_LIMIT=100
# Enable response caching only when allowed by the selected provider plan.
EXTERNAL_SEARCH_CACHE_SECONDS=0
EXTERNAL_SEARCH_ARCHIVE_URLS=true
ARCHIVE_WORKERS=32
OPENAI_API_KEY=
DR_SPIN_MODEL=
DR_SPIN_DAILY_CALL_LIMIT=20

# AI web search (independent of Brave). Requires a compatible Responses web_search model.
DR_SPIN_RESEARCH_ENABLED=false
DR_SPIN_RESEARCH_MODEL=
DR_SPIN_RESEARCH_DAILY_LIMIT=20

# Reserved for the planned Mistral EU adapter. The application does not use it yet.
MISTRAL_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.eu.mistral.ai
MISTRAL_MODEL=mistral-small-2603
DR_SPIN_PROVIDER=openai

# Opt-in editorial AI adapters. Both are disabled by default. These adapters
# receive only consent-gated, bounded citation packets and cannot publish.
NIM_ENABLED=false
NIM_API_KEY=
NIM_EMBEDDING_MODEL=
NIM_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
NIM_RERANK_MODEL=
NIM_RERANK_URL=
GROQ_EDITORIAL_ENABLED=false
GROQ_API_KEY=
GROQ_EDITORIAL_MODEL=
GROQ_EDITORIAL_URL=https://api.groq.com/openai/v1/chat/completions

# Dedicated outreach mailbox (private local values; never commit real credentials).
SOURCE_MAIL_IMAP_ENABLED=false
SOURCE_MAIL_IMAP_HOST=
SOURCE_MAIL_IMAP_PORT=993
SOURCE_MAIL_IMAP_USERNAME=zrodla@spin.clinic
SOURCE_MAIL_IMAP_PASSWORD=
SOURCE_MAIL_SMTP_ENABLED=false
SOURCE_MAIL_SMTP_HOST=
SOURCE_MAIL_SMTP_PORT=465
SOURCE_MAIL_SMTP_USERNAME=
SOURCE_MAIL_SMTP_PASSWORD=
SOURCE_MAIL_SMTP_FROM=zrodla@spin.clinic
